{
  "name": "cadence",
  "private": true,
  "version": "0.1.0",
  "description": "Cadence V1 — rapid differential diagnosis drills for clinical trainees",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate": "tsx scripts/validate-content.ts",
    "coverage": "tsx scripts/coverage-report.ts",
    "coverage:html": "tsx scripts/coverage-report.ts --html coverage-map.html",
    "review": "tsx scripts/review-content.ts",
    "prebuild": "npm run validate",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "migrate": "tsx scripts/migrate-to-concepts.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/smoke.mjs",
    "ios:add": "npx cap add ios",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "playwright": "^1.62.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "ts-fsrs": "^5.4.1",
    "zod": "^3.25.76"
  }
}
